---
import BaseLayout from '../components/layout/BaseLayout.astro';
import RoadmapIndex from '../components/views/RoadmapIndex.svelte';
---

<BaseLayout
  title="Roadmap"
  description="A learning path for every domain in the atlas — foundations first, then the specialisations."
  currentPage="roadmap"
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Pathways</p>
      <h1 class="page-title">Learn any field, one step at a time</h1>
      <p class="page-subtitle">
        Every domain in the atlas has a learning path — foundations first,
        then the core, then the specialisations. Tick steps off as you go;
        progress is kept on this device.
      </p>
    </header>

    <RoadmapIndex client:only="svelte" />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 84px 40px 72px;
  }

  @media (max-width: 768px) {
    .page { padding: 36px 20px 56px; }
  }
</style>
