---
import BaseLayout from '../components/layout/BaseLayout.astro';

const roadmapModules = import.meta.glob('../data/roadmaps/*.json', { eager: true });

const roadmaps = Object.keys(roadmapModules).map((filePath) => {
  const fileName = filePath.split('/').pop().replace('.json', '');
  const data = roadmapModules[filePath].default;
  
  return {
    slug: fileName,
    title: fileName.charAt(0).toUpperCase() + fileName.slice(1).replace(/-/g, ' '),
    description: data.description || `Explore the ${fileName} learning path.`
  };
});
---

<BaseLayout title="Roadmaps" currentPage="roadmap">
  <div class="page-container">
    <div class="header-section">
      <div class="eyebrow">Pathways</div>
      <h1 class="page-title">Available Roadmaps</h1>
      <p class="page-subtitle">
        Select a discipline below to view its interactive learning path. 
        Add new <code>.json</code> files to the <code>data/roadmaps</code> folder to automatically expand this list.
      </p>
    </div>

    <div class="roadmap-grid">
      {roadmaps.map(roadmap => (
        <a href={`/roadmap/${roadmap.slug}`} class="roadmap-card">
          <h3>{roadmap.title}</h3>
          <p>{roadmap.description}</p>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container { max-width: 1000px; margin: 0 auto; padding: 60px 40px 80px; }
  .header-section { margin-bottom: 40px; }
  .eyebrow { font-family: 'Cormorant Garamond', serif; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; color: #d4a574; margin-bottom: 12px; }
  .page-title { font-family: 'Cormorant Garamond', serif; font-size: 48px; font-weight: 600; color: #e8e4d9; margin: 0 0 16px 0; }
  .page-subtitle { font-family: 'Inter', sans-serif; font-size: 16px; color: #888888; max-width: 600px; line-height: 1.6; margin: 0; }
  .page-subtitle code { background: #141414; padding: 2px 6px; border-radius: 4px; font-size: 14px; color: #d4a574; }
  
  .roadmap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; margin-top: 40px; }
  .roadmap-card { display: flex; flex-direction: column; background: #0f0f0f; border: 1px solid #1a1a1a; border-radius: 12px; padding: 24px; text-decoration: none; color: #e8e4d9; transition: all 0.3s ease; }
  .roadmap-card:hover { border-color: #d4a574; transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .roadmap-card h3 { font-family: 'Cormorant Garamond', serif; font-size: 24px; margin: 0 0 8px 0; color: #d4a574; }
  .roadmap-card p { font-family: 'Inter', sans-serif; font-size: 14px; color: #888888; margin: 0; line-height: 1.5; flex-grow: 1; }
  .roadmap-card .arrow { margin-top: 16px; font-size: 18px; color: #d4a574; transition: transform 0.3s ease; }
  .roadmap-card:hover .arrow { transform: translateX(4px); }
  
  @media (max-width: 768px) { .page-container { padding: 40px 20px 60px; } }
</style>