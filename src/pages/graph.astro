---
import BaseLayout from '../components/layout/BaseLayout.astro';
import GlobalGraph from '../components/views/GlobalGraph.svelte';
import domainsData from '../data/Domain/domains.json';

// Build the constellation straight from the atlas data instead of mocks:
// every trunk becomes a cluster, every domain/subdomain a star, and any two
// fields sharing a parent (or listed as adjacent) get a thread between them.
const clusterPalette = [
  '#2dd4bf', '#60a5fa', '#a78bfa', '#d4a574',
  '#f87171', '#34d399', '#fbbf24', '#94a3b8'
];

type FlatNode = {
  id: string;
  label: string;
  cluster: string;
  size: number;
  description: string;
};

const nodes: FlatNode[] = [];
const links: { source: string; target: string }[] = [];
const clusters: { name: string; color: string }[] = [];

domainsData.children.forEach((trunk: any, idx: number) => {
  const clusterName = trunk.name;
  clusters.push({ name: clusterName, color: clusterPalette[idx % clusterPalette.length] });

  // The trunk itself is the brightest star in its region
  nodes.push({
    id: trunk.id,
    label: trunk.name,
    cluster: clusterName,
    size: 15,
    description: `Main trunk of the atlas with ${trunk.children?.length ?? 0} domains beneath it.`,
  });

  (trunk.children ?? []).forEach((domain: any) => {
    const leafCount = domain.children?.length ?? 0;
    nodes.push({
      id: domain.id,
      label: domain.name,
      cluster: clusterName,
      size: 8 + Math.min(leafCount, 6),
      description: `${leafCount} fields mapped under ${domain.name}.`,
    });
    links.push({ source: trunk.id, target: domain.id });

    (domain.children ?? []).forEach((field: any) => {
      nodes.push({
        id: field.id,
        label: field.name,
        cluster: clusterName,
        size: 5,
        description: `${field.name}, part of ${domain.name}.`,
      });
      links.push({ source: domain.id, target: field.id });
    });
  });
});

// A handful of deliberate cross-trunk threads — the seams of the atlas where
// distant fields actually touch. These are curated, not generated.
const adjacency = [
  ['01-01', '02-01'], // physics ↔ mathematics
  ['01-03', '06-02'], // biology ↔ basic medical sciences
  ['06-03', '03-01'], // neuroscience ↔ psychology
  ['02-03', '02-01'], // AI ↔ mathematics
  ['02-03', '04-01'], // AI ↔ philosophy (mind, ethics of AI)
  ['04-02', '02-03'], // linguistics ↔ NLP
  ['05-03', '02-02'], // design ↔ computer science (HCI)
  ['03-02', '02-01'], // economics ↔ probability & statistics
  ['07-01', '03-03'], // law ↔ political science
  ['08-01', '01-01'], // electrical engineering ↔ physics
  ['01-04', '08-03'], // earth & space ↔ climate science
  ['04-03', '03-04'], // history ↔ anthropology
  ['05-02', '01-01'], // acoustics ↔ physics
  ['03-01', '06-01'], // psychology ↔ psychiatry
];
adjacency.forEach(([a, b]) => links.push({ source: a, target: b }));
---

<BaseLayout title="Graph View" currentPage="graph">
  <div class="page-container">
    <div class="header-section">
      <div class="eyebrow">Constellation</div>
      <h1 class="page-title">The whole atlas, drifting</h1>
      <p class="page-subtitle">
        Every field a star, every link a thread of thought. Click a star to read
        it, toggle a cluster to dim that region of the sky.
      </p>
    </div>

    <div class="graph-layout">
      <!-- Graph Canvas (control panel lives inside the Svelte component) -->
      <div class="graph-wrapper">
        <GlobalGraph client:only="svelte" nodes={nodes} links={links} clusters={clusters} />
        <div class="graph-hint">drag to nudge · scroll to zoom · click a star</div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 80px;
  }

  .header-section {
    margin-bottom: 40px;
  }

  .graph-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    height: 700px;
  }

  .graph-wrapper {
    position: relative;
    background: var(--bg-secondary);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: background-color 0.4s ease, border-color 0.4s ease;
  }

  .graph-hint {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 11px;
    color: var(--text-muted);
    background: var(--bg-primary);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--line);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .graph-layout {
      grid-template-columns: 1fr;
      height: auto;
    }
    .control-panel {
      height: auto;
    }
    .graph-wrapper {
      height: 500px;
    }
  }
</style>
