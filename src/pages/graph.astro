---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Constellation from '../components/views/Constellation.svelte';
---

<BaseLayout
  title="Graph View"
  description="The whole atlas as a drifting constellation — every field a star, every relation a thread."
  currentPage="graph"
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Constellation</p>
      <h1 class="page-title">The whole atlas, drifting</h1>
      <p class="page-subtitle">
        Every field a star, every link a thread of thought. Clusters glow by
        trunk; drag, zoom, and click a star to isolate its neighbourhood.
      </p>
    </header>

    <Constellation client:only="svelte" />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 84px 40px 72px;
  }

  @media (max-width: 768px) {
    .page { padding: 36px 20px 56px; }
  }
</style>
