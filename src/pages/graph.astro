---
import BaseLayout from '../components/layout/BaseLayout.astro';
import GlobalGraph from '../components/views/GlobalGraph.svelte';

// Positions are precomputed by scripts/layout.mjs and shipped in layout.bin, so
// the browser draws the same map on every visit rather than running a force
// simulation. The component fetches the artifacts itself.
---

<BaseLayout
  title="Graph"
  description="The whole atlas at once: 30,039 Wikipedia categories plotted by how their subtrees relate."
  currentPage="graph"
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Graph</p>
      <h1 class="page-title">The whole atlas at once</h1>
      <p class="page-subtitle">
        Every category is a point. Fine threads are the tree a category sits in;
        heavier ones join categories that share articles but belong to different
        branches. Click a point to see what it touches.
      </p>
    </header>

    <div class="canvas-wrap">
      <GlobalGraph client:only="svelte" />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 80px;
  }

  .intro { margin-bottom: 28px; }

  .canvas-wrap {
    height: 68vh;
    min-height: 520px;
  }

  @media (max-width: 900px) {
    .page { padding: 40px 20px 56px; }
    .canvas-wrap { height: 60vh; }
  }
</style>
