---
import BaseLayout from '../components/layout/BaseLayout.astro';
import HomeFan from '../components/views/HomeFan.svelte';
---

<BaseLayout
  title="Home"
  description="An atlas of 9,261 human knowledge disciplines, arranged as eight trunks you can wander."
  currentPage="home"
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Atlas Root</p>
      <h1 class="page-title">Where would you like to wander?</h1>
      <p class="page-subtitle">
        These are the main trunks of the atlas — every domain, subdomain, and
        roadmap below grows out from one of these.
      </p>
    </header>

    <HomeFan client:only="svelte" />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 40px 72px;
  }

  .intro {
    max-width: 720px;
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .page { padding: 36px 20px 56px; }
  }
</style>
