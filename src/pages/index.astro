---
import BaseLayout from '../components/layout/BaseLayout.astro';
import DomainTree from '../components/views/DomainTree.svelte';

// Mock data for the tree visualization (replace with your actual data loader later)
const mainDomains = [
  { id: '01', label: 'Sciences' },
  { id: '02', label: 'Mathematics & Logic' },
  { id: '03', label: 'Technology & Computing' },
  { id: '04', label: 'Humanities' },
  { id: '05', label: 'Social Sciences' },
  { id: '06', label: 'Arts & Culture' },
  { id: '07', label: 'Health & Medicine' },
  { id: '08', label: 'Law & Governance' },
];
---

<BaseLayout title="Home" currentPage="home">
  <div class="page-container">
    <div class="header-section">
      <div class="eyebrow">Welcome</div>
      <h1 class="page-title">Where would you like to wander today?</h1>
      <p class="page-subtitle">
        These are the main trunks of the atlas — every domain, subdomain, and 
        roadmap below grows out from one of these.
      </p>
    </div>

    <div class="search-bar">
      <span class="search-icon">⌕</span>
      <input type="text" id="domainSearch" placeholder="search main domains, e.g. sciences, arts, technology" />
    </div>

    <div class="tree-container">
      <DomainTree client:only="svelte" domains={mainDomains} />
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 80px;
  }

  .header-section {
    margin-bottom: 40px;
  }

  .tree-container {
    width: 100%;
    height: 600px;
    margin-top: 40px;
    position: relative;
  }

  @media (max-width: 768px) {
    .page-container {
      padding: 40px 20px 60px;
    }
    .tree-container {
      height: 500px;
    }
  }
</style>