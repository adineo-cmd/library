---
import BaseLayout from '../components/layout/BaseLayout.astro';
import DomainTree from '../components/views/DomainTree.svelte';

// The component fetches concepts.json itself. Passing 30,039 nodes through
// Astro's island serialiser would inline ~3.7MB of JSON into the HTML on every
// page load, before the client could fetch it once and cache it.
---

<BaseLayout
  title="Browse"
  description="An atlas of 30,039 Wikipedia categories, arranged as a browsable tree."
  currentPage="home"
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Browse</p>
      <h1 class="page-title">Where would you like to wander?</h1>
      <p class="page-subtitle">
        Every category on this atlas sits inside a larger one. Open a branch and
        follow it down, or search for a name you already have in mind.
      </p>
    </header>

    <DomainTree client:only="svelte" />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 40px 96px;
  }

  .intro { margin-bottom: 8px; }

  @media (max-width: 768px) {
    .page { padding: 44px 20px 64px; }
  }
</style>
