---
import BaseLayout from '../../components/layout/BaseLayout.astro';

export function getStaticPaths() {
  const roadmapModules = import.meta.glob('../../data/roadmaps/*.json', { eager: true });
  return Object.keys(roadmapModules).map((filePath) => {
    const fileName = filePath.split('/').pop().replace('.json', '');
    const title = fileName.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    return { params: { slug: fileName }, props: { data: roadmapModules[filePath].default, title } };
  });
}

const { data, title } = Astro.props;
---

<BaseLayout title={`${title} Roadmap`} currentPage="roadmap">
  <div class="page-container">
    <div class="header-section">
      <div class="eyebrow">Pathways</div>
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">Not a syllabus — a suggested trail. Solid marks the well-trodden path, dashed the interesting detours.</p>
    </div>

    <!-- Scrollable Wrapper for Mobile -->
    <div class="roadmap-scroll-wrapper">
      <div class="roadmap-canvas">
        <!-- SVG Layer for drawing connection lines -->
        <svg id="roadmap-svg" class="connections-svg"></svg>

        <!-- Root Node -->
        <div class="root-node">{data.name}</div>
        
        <!-- Central Spine Line -->
        <div class="spine-line"></div>
        
        <!-- Categories Loop -->
        {data.children.map((category, i) => (
          <div class="category-row" class:list={[i % 2 !== 0 && 'reverse']}>
            
            <!-- Subtopics Stack -->
            <div class="subtopics-stack">
              {category.children?.map((topic) => (
                <div class="topic-wrapper">
                  <div class={`topic-node 
                    ${topic.status === 'completed' ? 'completed' : ''} 
                    ${topic.status === 'active' ? 'active' : ''} 
                    ${topic.variant === 'alternative' ? 'alternative' : ''}`}>
                    <span>{topic.name}</span>
                    {topic.status === 'completed' && <span class="icon check">✓</span>}
                    {topic.status === 'active' && <span class="icon dot"></span>}
                  </div>
                </div>
              ))}
            </div>

            <!-- Center Category Node -->
            <div class="center-spacer">
              <div class={`category-node 
                ${category.status === 'completed' ? 'completed' : ''} 
                ${category.status === 'active' ? 'active' : ''}`}>
                {category.name}
              </div>
            </div>

            <!-- Empty Side for Balance -->
            <div class="empty-side"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Layout & Typography */
  .page-container { max-width: 1400px; margin: 0 auto; padding: 40px 20px 60px; }
  .header-section { margin-bottom: 30px; }
  .eyebrow { font-family: 'Cormorant Garamond', serif; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; color: #d4a574; margin-bottom: 8px; }
  .page-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px, 5vw, 48px); font-weight: 600; color: #e8e4d9; margin: 0 0 12px 0; }
  .page-subtitle { font-family: 'Inter', sans-serif; font-size: 15px; color: #888888; max-width: 600px; line-height: 1.5; margin: 0; }

  /* Scrollable Wrapper */
  .roadmap-scroll-wrapper { 
    width: 100%; 
    overflow-x: auto; 
    border: 1px solid #1a1a1a; 
    border-radius: 12px; 
    background: #0a0a0a;
    scrollbar-width: thin;
    scrollbar-color: #2a2a2a #0f0f0f;
    /* Enable smooth scrolling and pinch-to-zoom behavior */
    -webkit-overflow-scrolling: touch;
  }
  .roadmap-scroll-wrapper::-webkit-scrollbar { height: 6px; }
  .roadmap-scroll-wrapper::-webkit-scrollbar-track { background: #0f0f0f; border-radius: 4px; }
  .roadmap-scroll-wrapper::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 4px; }
  .roadmap-scroll-wrapper::-webkit-scrollbar-thumb:hover { background: #d4a574; }

  /* Roadmap Canvas */
  .roadmap-canvas { 
    background: #0f0f0f; 
    padding: 50px 40px; 
    position: relative; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    min-width: 900px; /* Default desktop min-width */
    min-height: 600px; 
    box-sizing: border-box;
  }

  /* SVG Connections Layer */
  .connections-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }
  
  .root-node { 
    background: #1a1a1a; 
    border: 2px solid #d4a574; 
    color: #d4a574; 
    padding: 14px 36px; 
    border-radius: 30px; 
    font-size: 17px; 
    font-weight: 600; 
    z-index: 2; 
    margin-bottom: 50px; 
    box-shadow: 0 4px 20px rgba(212, 165, 116, 0.1); 
    position: relative; 
    white-space: nowrap;
  }
  
  .spine-line { 
    position: absolute; 
    top: 110px; 
    bottom: 50px; 
    left: 50%; 
    width: 3px; 
    background: #d4a574; 
    transform: translateX(-50%); 
    z-index: 1; 
    opacity: 0.8; 
  }

  /* Category Rows */
  .category-row { 
    display: grid; 
    grid-template-columns: 1fr 220px 1fr; 
    align-items: center; 
    width: 100%; 
    max-width: 1100px; 
    margin-bottom: 70px; 
    position: relative; 
    z-index: 2; 
  }
  .category-row.reverse { direction: rtl; }
  .category-row.reverse > * { direction: ltr; }

  .subtopics-stack { display: flex; flex-direction: column; gap: 14px; padding: 0 30px; z-index: 2; }
  .category-row:not(.reverse) .subtopics-stack { align-items: flex-end; }
  .category-row.reverse .subtopics-stack { align-items: flex-start; }

  .center-spacer { display: flex; justify-content: center; z-index: 2; }
  .empty-side { }

  /* Nodes */
  .category-node { 
    background: #141414; 
    border: 2px solid #d4a574; 
    color: #e8e4d9; 
    padding: 14px 20px; 
    border-radius: 10px; 
    font-size: 14px; 
    font-weight: 600; 
    text-align: center; 
    width: 100%; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.3); 
    transition: transform 0.3s ease; 
    position: relative; 
    white-space: nowrap;
  }
  .category-node:hover { transform: scale(1.05); }
  .category-node.completed { border-color: #2dd4bf; }
  .category-node.active { border-color: #d4a574; box-shadow: 0 0 20px rgba(212, 165, 116, 0.3); }

  .topic-wrapper { position: relative; z-index: 2; }
  .topic-node { 
    background: #141414; 
    border: 1px solid #2a2a2a; 
    color: #e8e4d9; 
    padding: 10px 16px; 
    border-radius: 8px; 
    font-size: 12px; 
    text-align: center; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    gap: 8px; 
    min-width: 160px; 
    max-width: 220px; 
    transition: all 0.3s ease; 
    white-space: normal;
    line-height: 1.3;
  }
  .topic-node:hover { border-color: #d4a574; background: #1a1a1a; }
  .topic-node.completed { border-color: #2dd4bf; }
  .topic-node.active { border-color: #d4a574; }
  .topic-node.alternative { border-style: dashed; border-color: #555; color: #a0a0a0; }

  .icon.check { color: #2dd4bf; font-weight: bold; font-size: 13px; flex-shrink: 0; }
  .icon.dot { width: 7px; height: 7px; border-radius: 50%; background: #d4a574; box-shadow: 0 0 8px #d4a574; flex-shrink: 0; }

  /* =========================================
     AGGRESSIVE MOBILE OPTIMIZATIONS
     ========================================= */
    @media (max-width: 768px) {
    .page-container { padding: 20px 10px 40px; }
    
    /* Force the map to fit within a standard phone width */
    .roadmap-canvas { 
      padding: 20px 10px; 
      min-width: 380px; 
    }
    
    /* Shrink the center column significantly */
    .category-row { 
      grid-template-columns: 1fr 90px 1fr; 
      margin-bottom: 25px; 
    }
    
    .subtopics-stack { 
      gap: 4px; 
      padding: 0 5px; 
    }

    /* Tiny Root Node */
    .root-node { 
      font-size: 10px; 
      padding: 6px 16px; 
      margin-bottom: 20px; 
    }
    
    /* Tiny Category Node */
    .category-node { 
      font-size: 8px; 
      padding: 4px 8px; 
      border-radius: 6px;
    }
    
    /* Tiny Topic Nodes */
    .topic-node { 
      font-size: 7px; 
      padding: 3px 6px; 
      min-width: 70px; 
      max-width: 100px;
      border-radius: 4px;
      gap: 2px;
    }

    .icon.check { font-size: 8px; }
    .icon.dot { width: 4px; height: 4px; }

    .spine-line { width: 1px; top: 60px; }
  }
</style>

<script>
  // Vanilla JS to draw smooth SVG connections, optimized for scrollable containers
  function drawConnections() {
    const svg = document.getElementById('roadmap-svg');
    const canvas = document.querySelector('.roadmap-canvas');
    if (!svg || !canvas) return;

    svg.innerHTML = '';
    
    // Set SVG size to match the actual scrollable content size
    svg.setAttribute('width', canvas.scrollWidth);
    svg.setAttribute('height', canvas.scrollHeight);

    const canvasRect = canvas.getBoundingClientRect();
    const scrollLeft = canvas.scrollLeft;
    const scrollTop = canvas.scrollTop;

    document.querySelectorAll('.category-row').forEach(row => {
      const catNode = row.querySelector('.category-node');
      const topicNodes = row.querySelectorAll('.topic-node');

      if (!catNode || topicNodes.length === 0) return;

      const catRect = catNode.getBoundingClientRect();
      const catCenterY = catRect.top - canvasRect.top + scrollTop + (catRect.height / 2);

      topicNodes.forEach(topic => {
        const topicRect = topic.getBoundingClientRect();
        const topicCenterY = topicRect.top - canvasRect.top + scrollTop + (topicRect.height / 2);

        let startX, endX;
        
        if (topicRect.left < catRect.left) {
          startX = topicRect.right - canvasRect.left + scrollLeft;
          endX = catRect.left - canvasRect.left + scrollLeft;
        } else {
          startX = topicRect.left - canvasRect.left + scrollLeft;
          endX = catRect.right - canvasRect.left + scrollLeft;
        }

        const midX = (startX + endX) / 2;
        const pathData = `M ${startX} ${topicCenterY} C ${midX} ${topicCenterY}, ${midX} ${catCenterY}, ${endX} ${catCenterY}`;

        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', pathData);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', '#2a2a2a');
        path.setAttribute('stroke-width', '2');
        
        svg.appendChild(path);
      });
    });
  }

  window.addEventListener('load', drawConnections);
  window.addEventListener('resize', drawConnections);
  
  const wrapper = document.querySelector('.roadmap-scroll-wrapper');
  if (wrapper) {
    wrapper.addEventListener('scroll', drawConnections);
  }

  if (document.readyState === 'complete') {
    drawConnections();
  }
</script>