# Generated Wikipedia-dump artifacts (concepts.json, crosslinks.json,
# layout.bin, meta.json) — regenerable with `npm run build:artifacts`,
# never committed. The small Wikidata-derived artifacts below ARE committed:
# the Pages workflow builds from the repo and cannot fetch from Wikidata.
public/data/artifacts/*
!public/data/artifacts/structure.json
!public/data/artifacts/roadmaps.json
!public/data/artifacts/taxonomy-layout.bin

# English Wikipedia SQL dumps. ingest.mjs prefers this directory whenever
# enwiki-latest-page.sql.gz sits here, so the rule cannot live only in the
# parent repo's .gitignore: they are 2.5 GB each and must never be committed.
enwiki-latest-*.sql.gz
*.sql.gz
